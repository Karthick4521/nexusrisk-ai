# Gemini API key (optional). If left unset, the app runs fully on the
# deterministic fallback path — all risk analysis still works, only the
# natural-language AI explanation is replaced with a rule-based summary.
GEMINI_API_KEY=your_api_key_here

# Optional: override the Gemini model name
GEMINI_MODEL=gemini-1.5-flash

# Server host/port. Default port changed from the original spec's 8000 to 8010.
HOST=0.0.0.0
PORT=8010
